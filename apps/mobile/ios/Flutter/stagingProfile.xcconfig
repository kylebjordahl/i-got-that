#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

ASSET_PREFIX=staging
BUNDLE_NAME=IGT Staging
BUNDLE_DISPLAY_NAME=IGT Staging

// Native Sign in with Google (staging). Fill in once the staging iOS OAuth
// client exists in the Cloud Console (bundle id com.kylebjordahl.igt.staging)
// — see docs/AUTH.md's Google section. Empty ⇒ native Google sign-in fails at
// runtime with a clear "no client ID" error (web flow is unaffected).
GOOGLE_IOS_CLIENT_ID=503268168924-honi8hhgikagd2gbu2tpb9qrf0n6eqcm.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.503268168924-honi8hhgikagd2gbu2tpb9qrf0n6eqcm

// flutter_web_auth_2's callback scheme for the native "connect a Google
// Calendar" wizard (distinct from Sign in with Google above) — must match the
// API's GOOGLE_IOS_OAUTH_CALLBACK_SCHEME for this env (wrangler.jsonc).
GOOGLE_OAUTH_CALLBACK_SCHEME=com.kylebjordahl.igt.staging.oauth

// APNs environment this build's `aps-environment` entitlement is signed with
// (Runner.entitlements reads $(APS_ENVIRONMENT), and Info.plist surfaces the
// same value as IGTApsEnvironment so the app reports the matching APNs host to
// the server). Debug builds are signed with a development profile, whose tokens
// only route via api.sandbox.push.apple.com; archives — TestFlight included —
// use the production host.
APS_ENVIRONMENT=production
