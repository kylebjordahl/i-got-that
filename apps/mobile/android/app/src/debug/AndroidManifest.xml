<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only cleartext exemption for local `wrangler dev`. `apiBaseUrl`
         defaults to http://localhost:8787 (lib/state/auth.dart), which from an
         emulator is http://10.0.2.2:8787 instead; cleartext HTTP has been
         blocked by default since API 28, so without this a local run just
         fails to connect. Debug-only on purpose: release builds stay
         cleartext-free, and the exemption is scoped to the loopback hosts
         rather than opening cleartext app-wide.

         See apps/mobile/README.md for the `flutter run` invocation that points
         a debug build at a local API.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
